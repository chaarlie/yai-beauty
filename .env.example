# Copy to .env.local for development, and add the same keys in
# Vercel → Settings → Environment Variables for production.
# Never commit real values.

# ── Sanity (offers) ───────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Server-only, and only needed if the dataset is private.
SANITY_API_READ_TOKEN=
# Server-only. Editor token: /admin saves, and Yasmin's account in the private
# dataset below.
SANITY_API_WRITE_TOKEN=
# Private dataset for the /admin account (its password hash). Defaults to "admin".
SANITY_ADMIN_DATASET=admin

# ── Admin login (/admin) ──────────────────────────────────────
# The one address allowed in. Yasmin creates the account herself from an invite
# link — `npm run admin:invite` prints one; the same command resets a password.
ADMIN_EMAIL=
# 32+ random characters that sign sessions and invite links. Generate it with:
#   npm run admin:invite -- --secret
# Use the same value here and in Vercel, or links made here fail there.
# Changing it signs every session out and voids unused links.
ADMIN_SESSION_SECRET=

# Photos are served from the public Supabase bucket by URL (lib/content.ts) and
# need no key at runtime.

# Canonical public origin for metadata, sitemap and admin invite links.
SITE_URL=https://yai-beauty.vercel.app
